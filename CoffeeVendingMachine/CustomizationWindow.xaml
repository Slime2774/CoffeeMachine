<Window x:Class="CoffeeVendingMachine.CustomizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Настройка напитка"
        Height="620" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5E6D3">

    <Window.Resources>
        <!-- Стили для однотипных элементов -->
        <Style TargetType="TextBlock" x:Key="HeaderStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4B3621"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,15,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#4B3621"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,15,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#4B3621"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с названием выбранного кофе -->
        <Border Grid.Row="0" Background="#6F4E37" CornerRadius="10" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Настройка: " FontSize="20" Foreground="#FFF8F0" VerticalAlignment="Center"/>
                <!-- Сюда будет подставляться название из главного окна -->
                <TextBlock x:Name="CoffeeNameText" Text="Капучино" FontSize="20" FontWeight="Bold" Foreground="#FFF8F0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Прокручиваемая область с настройками -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,15,0,15">
            <StackPanel>

                <!-- 1. ОБЪЕМ -->
                <TextBlock Text="Объём:" Style="{StaticResource HeaderStyle}"/>
                <WrapPanel>
                    <RadioButton Content="Маленький (200 мл)" IsChecked="True"/>
                    <RadioButton Content="Средний (300 мл)"/>
                    <RadioButton Content="Большой (400 мл)"/>
                </WrapPanel>

                <!-- 2. КРЕПОСТЬ (Доп. порция эспрессо) -->
                <TextBlock Text="Крепость:" Style="{StaticResource HeaderStyle}"/>
                <WrapPanel>
                    <RadioButton Content="Стандартная" IsChecked="True"/>
                    <RadioButton Content="+1 шот эспрессо"/>
                    <RadioButton Content="+2 шота эспрессо"/>
                </WrapPanel>

                <!-- 3. САХАР -->
                <TextBlock Text="Количество сахара:" Style="{StaticResource HeaderStyle}"/>
                <WrapPanel>
                    <RadioButton Content="Без сахара" IsChecked="True"/>
                    <RadioButton Content="1 ложка"/>
                    <RadioButton Content="2 ложки"/>
                    <RadioButton Content="3 ложки"/>
                </WrapPanel>

                <!-- 4. СИРОПЫ -->
                <TextBlock Text="Сиропы:" Style="{StaticResource HeaderStyle}"/>
                <WrapPanel>
                    <CheckBox Content="Карамель"/>
                    <CheckBox Content="Ваниль"/>
                    <CheckBox Content="Лесной орех"/>
                    <CheckBox Content="Шоколад"/>
                </WrapPanel>

                <!-- 5. ТОППИНГИ -->
                <TextBlock Text="Топпинги:" Style="{StaticResource HeaderStyle}"/>
                <WrapPanel>
                    <CheckBox Content="Корица"/>
                    <CheckBox Content="Какао-порошок"/>
                    <CheckBox Content="Маршмеллоу"/>
                    <CheckBox Content="Взбитые сливки"/>
                </WrapPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки внизу -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Отмена" Height="45" Margin="0,0,10,0"
                    Background="#E8D5B7" Foreground="#4B3621" FontSize="16" FontWeight="Bold"
                    BorderBrush="#D2B48C" BorderThickness="1.5" Click="Cancel_Click"/>

            <Button Grid.Column="1" Content="Добавить в заказ" Height="45" Margin="10,0,0,0"
                    Background="#6F4E37" Foreground="#FFF8F0" FontSize="16" FontWeight="Bold"
                    BorderBrush="#4B3621" BorderThickness="1.5" Click="Confirm_Click"/>
        </Grid>
    </Grid>
</Window>