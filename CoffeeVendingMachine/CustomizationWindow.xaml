<Window x:Class="CoffeeVendingMachine.CustomizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка" Height="650" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5E6D3">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="HeaderStyle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4B3621"/>
            <Setter Property="Margin" Value="0,15,0,8"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,15,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#4B3621"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,15,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#4B3621"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#6F4E37" CornerRadius="10" Padding="15">
            <StackPanel>
                <TextBlock x:Name="CoffeeNameText" Text="Напиток" FontSize="22" FontWeight="Bold" Foreground="#FFF8F0" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DrinkTypeText" Text="Тип" FontSize="14" Foreground="#D2B48C" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Настройки -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10">
            <StackPanel>
                <TextBlock Text="Объём:" Style="{StaticResource HeaderStyle}"/>
                <WrapPanel x:Name="SizesPanel"/>

                <TextBlock Text="Крепость (доп. эспрессо):" Style="{StaticResource HeaderStyle}"/>
                <WrapPanel>
                    <RadioButton x:Name="ShotStandard" Content="Стандарт" IsChecked="True" Tag="0" Checked="Option_Changed"/>
                    <RadioButton x:Name="Shot1" Content="+1 шот" Tag="1" Checked="Option_Changed"/>
                    <RadioButton x:Name="Shot2" Content="+2 шота" Tag="2" Checked="Option_Changed"/>
                </WrapPanel>

                <TextBlock Text="Количество сахара:" Style="{StaticResource HeaderStyle}"/>
                <WrapPanel>
                    <RadioButton Content="Без сахара" IsChecked="True"/>
                    <RadioButton Content="1 ложка"/>
                    <RadioButton Content="2 ложки"/>
                    <RadioButton Content="3 ложки"/>
                </WrapPanel>

                <TextBlock x:Name="SyrupHeader" Text="Сиропы:" Style="{StaticResource HeaderStyle}"/>
                <WrapPanel x:Name="SyrupPanel">
                    <CheckBox Content="Карамель" Tag="Карамель" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <CheckBox Content="Ваниль" Tag="Ваниль" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <CheckBox Content="Лесной орех" Tag="Лесной орех" Checked="Option_Changed" Unchecked="Option_Changed"/>
                </WrapPanel>

                <TextBlock x:Name="ToppingHeader" Text="Топпинги:" Style="{StaticResource HeaderStyle}"/>
                <WrapPanel x:Name="ToppingPanel">
                    <CheckBox Content="Корица" Tag="Корица" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <CheckBox Content="Маршмеллоу" Tag="Маршмеллоу" Checked="Option_Changed" Unchecked="Option_Changed"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Низ: Цена и Кнопки -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TotalPriceText" Grid.Row="0" Text="Итого: 0 ₽" 
                       FontSize="22" FontWeight="Bold" Foreground="#6F4E37" 
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Отмена" Height="45" Margin="0,0,10,0" 
                        Background="#E8D5B7" Foreground="#4B3621" FontWeight="Bold" Click="Cancel_Click"/>

                <Button Grid.Column="1" Content="Оплатить" Height="45" Margin="10,0,0,0" 
                        Background="#6F4E37" Foreground="White" FontWeight="Bold" Click="Confirm_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>