<Window x:Class="CoffeeVendingMachine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coffee Vending Machine" Height="800" Width="750"
        Background="#F0F0F0" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="CoffeeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="130"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#222"/>
                    <Setter Property="BorderBrush" Value="#D4A373"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <LinearGradientBrush x:Key="WoodStripe" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4A2E1B" Offset="0.0"/>
            <GradientStop Color="#2B1A0F" Offset="1.0"/>
        </LinearGradientBrush>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EEE"/>
            <Setter Property="Margin" Value="0,5,15,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEE"/>
            <Setter Property="Margin" Value="0,5,15,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Border Margin="15" Background="#121212" CornerRadius="15" BorderBrush="#000" BorderThickness="3">
        <!-- У Border только ОДИН дочерний элемент - Grid -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <!-- Козырек -->
                <RowDefinition Height="*"/>
                <!-- Рабочая зона -->
                <RowDefinition Height="160"/>
                <!-- Нижняя тумба -->
            </Grid.RowDefinitions>

            <!-- 1. КОЗЫРЕК -->
            <Border Grid.Row="0" Background="#0A0A0A" CornerRadius="12,12,0,0" BorderBrush="#222" BorderThickness="0,0,0,2">
                <Grid>
                    <Border Height="20" VerticalAlignment="Bottom" Background="#3E2614" Margin="0,0,0,10"/>
                    <TextBlock Text="Coffee" FontSize="52" FontFamily="Georgia" Foreground="#FFF3E0" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFD54F" BlurRadius="25" ShadowDepth="0" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-5">
                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="30,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FFF" BlurRadius="10"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="30,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FFF" BlurRadius="10"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="30,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FFF" BlurRadius="10"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="8" Height="8" Fill="#FFF" Margin="30,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FFF" BlurRadius="10"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. РАБОЧАЯ ЗОНА -->
            <Grid Grid.Row="1" Background="#161616">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ ПАНЕЛЬ -->
                <Border Grid.Column="0" BorderBrush="#222" BorderThickness="0,0,2,0" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#0A0A0A" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Padding="10" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="СИСТЕМНЫЙ СТАТУС" Foreground="#444" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock x:Name="StatusText" Text="Выберите напиток" FontSize="13" FontWeight="Bold" Foreground="#4CAF50" TextAlignment="Center" TextWrapping="Wrap"/>
                                <StackPanel x:Name="ProgressContainer" Margin="0,10,0,0" Visibility="Collapsed">
                                    <ProgressBar x:Name="BrewProgress" Height="6" Maximum="100" Background="#111" Foreground="#D4A373" BorderThickness="0"/>
                                    <TextBlock x:Name="BrewingText" Text="Готовим..." Foreground="#888" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="#0A0A0A" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Padding="10" Margin="0,0,0,15" Cursor="Hand" MouseLeftButtonUp="Change_Click">
                            <StackPanel>
                                <TextBlock Text="СДАЧА" Foreground="#444" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ChangeMoneyText" Text="0 ₽" FontSize="22" FontWeight="Bold" Foreground="#D4A373" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ЦЕНТРАЛЬНЫЙ ЭКРАН (Слои) -->
                <Border Grid.Column="1" Background="#0A0A0A" CornerRadius="10" BorderBrush="#333" BorderThickness="2" Margin="15">
                    <Grid>
                        <!-- Слой 1: Меню -->
                        <Grid x:Name="MenuView" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="МЕНЮ НАПИТКОВ" Foreground="#555" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="15"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CoffeeList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CoffeeCardStyle}" Tag="{Binding}" MouseLeftButtonUp="CoffeeCard_Click">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Icon}" FontSize="34" HorizontalAlignment="Center" Foreground="#D4A373" Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#EEE" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,5"/>
                                                    <TextBlock Text="{Binding PriceText}" FontSize="13" FontWeight="Bold" Foreground="#666" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Слой 2: Настройка -->
                        <Grid x:Name="CustomizationView" Visibility="Collapsed" Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock x:Name="CustomCoffeeName" Text="Напиток" FontSize="20" FontWeight="Bold" Foreground="#D4A373" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CustomDrinkType" Text="Тип" FontSize="12" Foreground="#666" HorizontalAlignment="Center" Margin="0,5,0,15"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="ОБЪЁМ:" Foreground="#666" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <WrapPanel x:Name="SizesPanel" Margin="0,0,0,15"/>

                                    <TextBlock Text="КРЕПОСТЬ:" Foreground="#666" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <WrapPanel Margin="0,0,0,15">
                                        <RadioButton x:Name="ShotStandard" Content="Стандарт" IsChecked="True" Tag="0" Checked="Option_Changed"/>
                                        <RadioButton x:Name="Shot1" Content="+1 шот" Tag="1" Checked="Option_Changed"/>
                                        <RadioButton x:Name="Shot2" Content="+2 шота" Tag="2" Checked="Option_Changed"/>
                                    </WrapPanel>

                                    <TextBlock Text="САХАР:" Foreground="#666" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <WrapPanel Margin="0,0,0,15">
                                        <RadioButton Content="Без сахара" IsChecked="True"/>
                                        <RadioButton Content="1 ложка"/>
                                        <RadioButton Content="2 ложки"/>
                                        <RadioButton Content="3 ложки"/>
                                    </WrapPanel>

                                    <TextBlock x:Name="SyrupHeader" Text="СИРОПЫ:" Foreground="#666" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <WrapPanel x:Name="SyrupPanel" Margin="0,0,0,15">
                                        <CheckBox Content="Карамель" Tag="Карамель" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                        <CheckBox Content="Ваниль" Tag="Ваниль" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                        <CheckBox Content="Лесной орех" Tag="Лесной орех" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                    </WrapPanel>

                                    <TextBlock x:Name="ToppingHeader" Text="ТОППИНГИ:" Foreground="#666" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <WrapPanel x:Name="ToppingPanel" Margin="0,0,0,15">
                                        <CheckBox Content="Корица" Tag="Корица" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                        <CheckBox Content="Маршмеллоу" Tag="Маршмеллоу" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <TextBlock x:Name="TotalPriceText" Text="Итого: 0 ₽" FontSize="20" FontWeight="Bold" Foreground="#D4A373" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1">
                                    <Button Content="Отмена" Width="120" Height="40" Margin="5" Background="#222" Foreground="#FFF" BorderThickness="0" Click="CancelCustomization_Click"/>
                                    <Button Content="Оплатить" Width="120" Height="40" Margin="5" Background="#D4A373" Foreground="#111" FontWeight="Bold" BorderThickness="0" Click="ConfirmCustomization_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Слой 3: Оплата -->
                        <Grid x:Name="PaymentView" Visibility="Collapsed" Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="PaymentPriceText" Text="0 ₽" FontSize="32" FontWeight="Bold" Foreground="#D4A373" HorizontalAlignment="Center" Margin="0,10,0,20"/>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <Button x:Name="PayByCardBtn" Content="💳 ОПЛАТИТЬ КАРТОЙ" Height="50" Margin="0,0,0,20" Background="#333" Foreground="#FFF" FontWeight="Bold" BorderThickness="0" Click="PayByCard_Click"/>

                                <TextBlock Text="ИЛИ ВНЕСИТЕ НАЛИЧНЫЕ:" Foreground="#666" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                                    <Button Content="+50" Width="70" Height="40" Margin="5" Click="InsertCash_Click" Tag="50" Background="#222" Foreground="#EEE" BorderThickness="0"/>
                                    <Button Content="+100" Width="70" Height="40" Margin="5" Click="InsertCash_Click" Tag="100" Background="#222" Foreground="#EEE" BorderThickness="0"/>
                                    <Button Content="+500" Width="70" Height="40" Margin="5" Click="InsertCash_Click" Tag="500" Background="#222" Foreground="#EEE" BorderThickness="0"/>
                                </StackPanel>

                                <Border Background="#111" CornerRadius="8" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Внесено:" Foreground="#666" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="InsertedText" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#EEE" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Сдача:" Foreground="#666" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        <TextBlock x:Name="PaymentChangeText" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Отмена" Height="45" Margin="0,0,10,0" Background="#222" Foreground="#FFF" BorderThickness="0" Click="CancelPayment_Click"/>
                                <Button Grid.Column="1" x:Name="ConfirmCashBtn" Content="Готово" Height="45" Margin="10,0,0,0" Background="#4CAF50" Foreground="#FFF" FontWeight="Bold" BorderThickness="0" Click="ConfirmCash_Click" IsEnabled="False"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ПРАВАЯ КОЛОНКА: ДЕКОР СВЕРХУ, ШАХТА СНИЗУ -->
                <Border Grid.Column="2" Background="#111" BorderBrush="#222" BorderThickness="2,0,0,0" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Border Height="10" VerticalAlignment="Center" Background="{StaticResource WoodStripe}" CornerRadius="2" Margin="0,20,0,0"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Path Data="M 15,0 Q 15,-20 25,-30 M 15,-10 Q 25,-15 30,-10 M 15,-15 Q 5,-20 0,-15" Stroke="#4CAF50" StrokeThickness="2" Fill="Transparent"/>
                                <Ellipse Width="15" Height="10" Fill="#4CAF50" HorizontalAlignment="Center" Margin="20,-10,0,0"/>
                                <Ellipse Width="10" Height="8" Fill="#4CAF50" HorizontalAlignment="Center" Margin="0,0,20,0"/>
                                <Path Data="M 0,0 L 30,0 L 25,25 L 5,25 Z" Fill="#8B4513" Stroke="#5A2E0C" StrokeThickness="1"/>
                                <Rectangle Width="34" Height="5" Fill="#A0522D" Margin="0,-5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="#020202" CornerRadius="5" BorderBrush="#222" BorderThickness="2">
                            <Grid>
                                <TextBlock Text="ВЫДАЧА" Foreground="#333" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                <StackPanel x:Name="EmptyCupPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🥤" FontSize="30" Opacity="0.05" Foreground="White"/>
                                </StackPanel>
                                <Grid x:Name="CoffeeCup" Width="60" Height="85" VerticalAlignment="Bottom" HorizontalAlignment="Center" Opacity="0" Margin="0,0,0,20" Cursor="Hand" MouseLeftButtonUp="Cup_Click">
                                    <Ellipse Width="50" Height="10" VerticalAlignment="Bottom" Fill="#000" Margin="0,0,0,-5" Opacity="0.8"/>
                                    <Path Data="M 5,5 L 55,5 L 45,70 Q 30,75 15,70 Z">
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#EAEAEA" Offset="0.0"/>
                                                <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#D0D0D0" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>
                                    <Grid x:Name="CoffeeLiquidContainer">
                                        <Grid.Clip>
                                            <PathGeometry Figures="M 6,6 L 54,6 L 44,69 Q 30,74 16,69 Z" />
                                        </Grid.Clip>
                                        <Rectangle x:Name="CoffeeLiquid" VerticalAlignment="Bottom" Height="0" Fill="#6F4E37" Margin="5,0,5,0"/>
                                    </Grid>
                                    <Path Data="M 5,5 L 55,5 L 45,70 Q 30,75 15,70 Z" Stroke="#888" StrokeThickness="1" Fill="Transparent"/>
                                    <Path Data="M 2,2 L 58,2 L 55,8 L 5,8 Z" Fill="#FFF" Stroke="#CCC" StrokeThickness="1"/>
                                </Grid>
                                <TextBlock x:Name="TakeCupText" Text="ЗАБРАТЬ" FontSize="9" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0" Margin="0,0,0,2"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. НИЖНЯЯ ТУМБА -->
            <Border Grid.Row="2" Background="#0A0A0A" CornerRadius="0,0,12,12" BorderBrush="#222" BorderThickness="0,2,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#161616" Margin="10" CornerRadius="5" BorderBrush="#333" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                            <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                            <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                            <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                            <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                            <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#161616" Margin="10" CornerRadius="5" BorderBrush="#333" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                            <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                            <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                            <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                            <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                            <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>