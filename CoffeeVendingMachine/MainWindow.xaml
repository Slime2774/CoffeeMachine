<Window x:Class="CoffeeVendingMachine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coffee Vending Machine" Height="640" Width="820"
        MinHeight="640" MinWidth="820"
        Background="#F5E6D3"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="CoffeeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF8F0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="160"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#D2B48C"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#8B6F47" BlurRadius="6" ShadowDepth="2" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FDEBD0"/>
                    <Setter Property="BorderBrush" Value="#8B6F47"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ЧАСТЬ -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#6F4E37" CornerRadius="12" Padding="14,8" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="☕" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="COFFEE VENDING MACHINE" FontSize="18" FontWeight="Bold" Foreground="#FFF8F0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Меню -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding CoffeeList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CoffeeCardStyle}" Tag="{Binding}" MouseLeftButtonUp="CoffeeCard_Click">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="38" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#4B3621" TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                    <TextBlock Text="{Binding PriceText}" FontSize="14" FontWeight="Bold"
                                               Foreground="#6F4E37" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Панель статуса -->
            <Border Grid.Row="2" Background="#FFF8F0" CornerRadius="10" Padding="10" Margin="0,10,0,0" BorderBrush="#A67B5B" BorderThickness="1.5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Статус автомата" Foreground="#8B6F47" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Выберите напиток" FontSize="16" FontWeight="Bold" Foreground="#6F4E37" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ПРАВАЯ ЧАСТЬ (Шахта выдачи) -->
        <Grid Grid.Column="1" VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шахта выдачи -->
            <Border Grid.Row="0" Background="#4B3621" CornerRadius="12" BorderBrush="#6F4E37" BorderThickness="2" Padding="8" Height="240">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ВЫДАЧА" FontSize="12" FontWeight="Bold" Foreground="#D2B48C" HorizontalAlignment="Center" Margin="0,2,0,6"/>

                    <!-- Окно выдачи -->
                    <Border Grid.Row="1" Background="#1A1005" CornerRadius="8" BorderBrush="#8B6F47" BorderThickness="2" Margin="0,0,0,6">
                        <Grid>
                            <!-- Заглушка "Стакан появится здесь" -->
                            <StackPanel x:Name="EmptyCupPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🍵" FontSize="34" HorizontalAlignment="Center" Opacity="0.4"/>
                                <TextBlock Text="Стакан" Foreground="#8B6F47" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="появится здесь" Foreground="#8B6F47" FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- ВЕКТОРНЫЙ СТАКАН С КЛИПОМ -->
                            <!-- Добавлены Cursor="Hand" и MouseLeftButtonUp="Cup_Click" -->
                            <Grid x:Name="CoffeeCup" Width="80" Height="100" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0"
                                  Cursor="Hand" MouseLeftButtonUp="Cup_Click">

                                <Ellipse Width="60" Height="10" VerticalAlignment="Bottom" Fill="#000000" Margin="0,0,0,2" Opacity="0.5"/>

                                <Path Data="M 10,10 L 70,10 L 60,90 Q 40,100 20,90 Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FDF8F2" Offset="0.0"/>
                                            <GradientStop Color="#E6C2A6" Offset="0.5"/>
                                            <GradientStop Color="#D8B291" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>

                                <Grid x:Name="CoffeeLiquidContainer">
                                    <Grid.Clip>
                                        <PathGeometry Figures="M 12,12 L 68,12 L 59,88 Q 40,97 21,88 Z" />
                                    </Grid.Clip>
                                    <Rectangle x:Name="CoffeeLiquid" VerticalAlignment="Bottom" Height="0" Fill="#6F4E37" Margin="10,0,10,0"/>
                                </Grid>

                                <Path Data="M 10,10 L 70,10 L 60,90 Q 40,100 20,90 Z" Stroke="#8E6645" StrokeThickness="1.5" Fill="Transparent"/>
                                <Path Data="M 5,5 L 75,5 L 70,15 L 10,15 Z" Fill="#FAFAFA" Stroke="#DDD" StrokeThickness="1"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="TakeCupText" Grid.Row="2" Text="Заберите напиток!" FontSize="11" FontWeight="Bold" Foreground="#00FF66" HorizontalAlignment="Center" Opacity="0" Margin="0,2,0,2"/>
                </Grid>
            </Border>

            <!-- ПРОГРЕСС-БАР -->
            <StackPanel Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Center" Width="120">
                <ProgressBar x:Name="BrewProgress" Height="8" Maximum="100" Background="#222222" Foreground="#E5A96A" BorderThickness="0" Visibility="Collapsed"/>
                <TextBlock x:Name="BrewingText" Text="" Foreground="#6F4E37" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Поле сдачи -->
            <!-- Добавлены Cursor="Hand" и MouseLeftButtonUp="Change_Click" -->
            <Border x:Name="ChangePanel" Grid.Row="2" Background="#A67B5B" CornerRadius="12" Padding="10" Margin="0,8,0,0" BorderBrush="#8B6F47" BorderThickness="2"
                    Cursor="Hand" MouseLeftButtonUp="Change_Click">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="💰" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Сдача" FontWeight="Bold" FontSize="12" Foreground="#FFF8F0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="ChangeMoneyText" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#FFF8F0" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>