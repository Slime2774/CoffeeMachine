<Window x:Class="CoffeeVendingMachine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coffee Network" Height="850" Width="800"
        Background="#E8E8E8" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления сетью -->
        <Border Background="#121212" BorderBrush="#333" BorderThickness="0,0,0,2">
            <Grid>
                <TextBlock Text="СЕТЬ КОФЕЙНЫХ АВТОМАТОВ" Foreground="#D4A373" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <Button Content="+ Добавить автомат" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" 
                        Background="#D4A373" Foreground="#111" FontWeight="Bold" Padding="10,5" Click="AddMachine_Click"/>
            </Grid>
        </Border>

        <!-- Ползунок для перелистывания автоматов -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="#F0F0F0">
            <StackPanel x:Name="MachinesContainer" Orientation="Horizontal" Margin="20"/>
        </ScrollViewer>
    </Grid>
</Window>