<Window x:Class="CoffeeVendingMachine.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оплата" Height="450" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5E6D3">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с суммой -->
        <Border Grid.Row="0" Background="#6F4E37" CornerRadius="10" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="К оплате:" FontSize="16" Foreground="#D2B48C" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TotalPriceText" Text="0 ₽" FontSize="32" FontWeight="Bold" Foreground="#FFF8F0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Способы оплаты -->
        <StackPanel Grid.Row="1">
            <!-- Оплата картой -->
            <Button x:Name="PayByCardBtn" Content="💳 Оплатить картой" Height="50" Margin="0,0,0,15"
                    Background="#3498DB" Foreground="White" FontSize="16" FontWeight="Bold" Click="PayByCard_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <TextBlock Text="Или внесите наличные:" Foreground="#6F4E37" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <!-- Внесение наличных -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Content="+50 ₽" Width="70" Height="40" Margin="5" Click="InsertCash_Click" Tag="50" Background="#E8D5B7" Foreground="#4B3621" FontWeight="Bold"/>
                <Button Content="+100 ₽" Width="70" Height="40" Margin="5" Click="InsertCash_Click" Tag="100" Background="#E8D5B7" Foreground="#4B3621" FontWeight="Bold"/>
                <Button Content="+500 ₽" Width="70" Height="40" Margin="5" Click="InsertCash_Click" Tag="500" Background="#E8D5B7" Foreground="#4B3621" FontWeight="Bold"/>
            </StackPanel>

            <!-- Баланс и сдача -->
            <Border Background="#FFF8F0" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Внесено:" Foreground="#8B6F47" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="InsertedText" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#6F4E37" HorizontalAlignment="Center"/>
                    <TextBlock Text="Сдача:" Foreground="#8B6F47" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock x:Name="ChangeText" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#2ECC71" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Кнопки подтверждения/отмены -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Отмена" Height="45" Margin="0,0,5,0" Background="#E8D5B7" Foreground="#4B3621" FontWeight="Bold" Click="Cancel_Click"/>
            <Button Grid.Column="1" x:Name="ConfirmCashBtn" Content="Готово" Height="45" Margin="5,0,0,0" Background="#2ECC71" Foreground="White" FontWeight="Bold" Click="ConfirmCash_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>