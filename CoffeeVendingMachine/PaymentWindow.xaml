<Window x:Class="CoffeeVendingMachine.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оплата" Height="520" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#161616"
        SizeToContent="Height">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0A0A0A" CornerRadius="10" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="К ОПЛАТЕ:" FontSize="12" Foreground="#666" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TotalPriceText" Text="0 ₽" FontSize="32" FontWeight="Bold" Foreground="#D4A373" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <Button x:Name="PayByCardBtn" Content="💳 ОПЛАТИТЬ КАРТОЙ" Height="50" Margin="0,0,0,20" 
                    Background="#333" Foreground="#FFF" FontSize="14" FontWeight="Bold" BorderThickness="0" Click="PayByCard_Click"/>

            <TextBlock Text="ИЛИ ВНЕСИТЕ НАЛИЧНЫЕ:" Foreground="#666" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button Content="+50" Width="70" Height="40" Margin="5" Click="InsertCash_Click" Tag="50" Background="#222" Foreground="#EEE" BorderThickness="0"/>
                <Button Content="+100" Width="70" Height="40" Margin="5" Click="InsertCash_Click" Tag="100" Background="#222" Foreground="#EEE" BorderThickness="0"/>
                <Button Content="+500" Width="70" Height="40" Margin="5" Click="InsertCash_Click" Tag="500" Background="#222" Foreground="#EEE" BorderThickness="0"/>
            </StackPanel>

            <Border Background="#0A0A0A" CornerRadius="8" Padding="10">
                <StackPanel>
                    <TextBlock Text="Внесено:" Foreground="#666" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="InsertedText" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#EEE" HorizontalAlignment="Center"/>
                    <TextBlock Text="Сдача:" Foreground="#666" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock x:Name="ChangeText" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Отмена" Height="45" Margin="0,0,10,0" Background="#222" Foreground="#FFF" FontWeight="Bold" BorderThickness="0" Click="Cancel_Click"/>
            <Button Grid.Column="1" x:Name="ConfirmCashBtn" Content="Готово" Height="45" Margin="10,0,0,0" Background="#4CAF50" Foreground="#FFF" FontWeight="Bold" BorderThickness="0" Click="ConfirmCash_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>