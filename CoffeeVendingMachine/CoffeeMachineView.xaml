<UserControl x:Class="CoffeeVendingMachine.CoffeeMachineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="750" Height="800">
    <UserControl.Resources>
        <Style x:Key="CoffeeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="130"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#222"/>
                    <Setter Property="BorderBrush" Value="#D4A373"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <LinearGradientBrush x:Key="WoodStripe" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4A2E1B" Offset="0.0"/>
            <GradientStop Color="#2B1A0F" Offset="1.0"/>
        </LinearGradientBrush>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EEE"/>
            <Setter Property="Margin" Value="0,5,15,5"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEE"/>
            <Setter Property="Margin" Value="0,5,15,5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ОСНОВНОЙ КОРПУС -->
        <Border Margin="15" Background="#121212" CornerRadius="15" BorderBrush="#000" BorderThickness="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="160"/>
                </Grid.RowDefinitions>

                <!-- КОЗЫРЕК -->
                <Border Grid.Row="0" Background="#0A0A0A" CornerRadius="12,12,0,0" BorderBrush="#222" BorderThickness="0,0,0,2">
                    <Grid>
                        <Border Height="20" VerticalAlignment="Bottom" Background="#3E2614" Margin="0,0,0,10"/>
                        <TextBlock Text="Coffee" FontSize="52" FontFamily="Georgia" Foreground="#FFF3E0" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFD54F" BlurRadius="25" ShadowDepth="0" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- РАБОЧАЯ ЗОНА -->
                <Grid Grid.Row="1" Background="#161616">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- ЛЕВАЯ ПАНЕЛЬ -->
                    <Border Grid.Column="0" BorderBrush="#222" BorderThickness="0,0,2,0" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#0A0A0A" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Padding="10" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="СИСТЕМНЫЙ СТАТУС" Foreground="#444" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="StatusText" Text="Выберите напиток" FontSize="13" FontWeight="Bold" Foreground="#4CAF50" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="ProgressContainer" Margin="0,10,0,0" Visibility="Collapsed">
                                        <ProgressBar x:Name="BrewProgress" Height="6" Maximum="100" Background="#111" Foreground="#D4A373" BorderThickness="0"/>
                                        <TextBlock x:Name="BrewingText" Text="Готовим..." Foreground="#888" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Background="#0A0A0A" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Padding="10" Margin="0,0,0,15" Cursor="Hand" MouseLeftButtonUp="Change_Click">
                                <StackPanel>
                                    <TextBlock Text="СДАЧА" Foreground="#444" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <WrapPanel x:Name="ChangeCoinsPanel" HorizontalAlignment="Center" Margin="0,5,0,0" MinHeight="20"/>
                                    <TextBlock x:Name="ChangeMoneyText" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#D4A373" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Row="2" VerticalAlignment="Bottom" Content="⚙ Настройки" Background="#222" Foreground="#888" BorderThickness="0" Click="ToggleAdmin_Click"/>
                        </Grid>
                    </Border>

                    <!-- ЦЕНТРАЛЬНЫЙ ЭКРАН (Содержит 6 слоев) -->
                    <Border Grid.Column="1" Background="#0A0A0A" CornerRadius="10" BorderBrush="#333" BorderThickness="2" Margin="15">
                        <Grid>
                            <!-- Слой 1: Меню -->
                            <Grid x:Name="MenuView" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="МЕНЮ НАПИТКОВ" Foreground="#555" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="15"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="CoffeeItemsControl">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource CoffeeCardStyle}" Tag="{Binding}" MouseLeftButtonUp="CoffeeCard_Click">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Icon}" FontSize="34" HorizontalAlignment="Center" Foreground="#D4A373" Margin="0,0,0,5"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#EEE" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,5"/>
                                                        <TextBlock Text="{Binding PriceText}" FontSize="13" FontWeight="Bold" Foreground="#666" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- Слой 2: Настройка -->
                            <Grid x:Name="CustomizationView" Visibility="Collapsed" Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock x:Name="CustomCoffeeName" Text="Напиток" FontSize="20" FontWeight="Bold" Foreground="#D4A373" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="CustomDrinkType" Text="Тип" FontSize="12" Foreground="#666" HorizontalAlignment="Center" Margin="0,5,0,15"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="ОБЪЁМ:" Foreground="#666" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <WrapPanel x:Name="SizesPanel" Margin="0,0,0,15"/>
                                        <TextBlock Text="КРЕПОСТЬ:" Foreground="#666" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <WrapPanel Margin="0,0,0,15">
                                            <RadioButton x:Name="ShotStandard" Content="Стандарт" IsChecked="True" Tag="0" Checked="Option_Changed" GroupName="Shots"/>
                                            <RadioButton x:Name="Shot1" Content="+1 шот" Tag="1" Checked="Option_Changed" GroupName="Shots"/>
                                            <RadioButton x:Name="Shot2" Content="+2 шота" Tag="2" Checked="Option_Changed" GroupName="Shots"/>
                                        </WrapPanel>
                                        <TextBlock Text="САХАР:" Foreground="#666" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <WrapPanel Margin="0,0,0,15">
                                            <RadioButton x:Name="Sugar0" Content="Без сахара" IsChecked="True" GroupName="Sugar"/>
                                            <RadioButton x:Name="Sugar1" Content="1 ложка" GroupName="Sugar"/>
                                            <RadioButton x:Name="Sugar2" Content="2 ложки" GroupName="Sugar"/>
                                            <RadioButton x:Name="Sugar3" Content="3 ложки" GroupName="Sugar"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="SyrupHeader" Text="СИРОПЫ:" Foreground="#666" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <WrapPanel x:Name="SyrupPanel" Margin="0,0,0,15">
                                            <CheckBox Content="Карамель" Tag="Карамель" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                            <CheckBox Content="Ваниль" Tag="Ваниль" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                            <CheckBox Content="Лесной орех" Tag="Лесной орех" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="ToppingHeader" Text="ТОППИНГИ:" Foreground="#666" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <WrapPanel x:Name="ToppingPanel" Margin="0,0,0,15">
                                            <CheckBox Content="Корица" Tag="Корица" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                            <CheckBox Content="Маршмеллоу" Tag="Маршмеллоу" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>
                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="TotalPriceText" Grid.Row="0" Text="Итого: 0 ₽" FontSize="20" FontWeight="Bold" Foreground="#D4A373" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Отмена" Width="120" Height="40" Margin="5" Background="#222" Foreground="#FFF" BorderThickness="0" Click="CancelCustomization_Click"/>
                                        <Button Content="Оплатить" Width="120" Height="40" Margin="5" Background="#D4A373" Foreground="#111" FontWeight="Bold" BorderThickness="0" Click="ConfirmCustomization_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Слой 3: Оплата -->
                            <Grid x:Name="PaymentView" Visibility="Collapsed" Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="PaymentPriceText" Text="0 ₽" FontSize="32" FontWeight="Bold" Foreground="#D4A373" HorizontalAlignment="Center" Margin="0,10,0,20"/>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <Button x:Name="PayByCardBtn" Content="💳 ОПЛАТИТЬ КАРТОЙ" Height="50" Margin="0,0,0,20" Background="#333" Foreground="#FFF" FontWeight="Bold" BorderThickness="0" Click="PayByCard_Click"/>
                                    <TextBlock Text="ИЛИ ВНЕСИТЕ НАЛИЧНЫЕ:" Foreground="#666" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                                        <Button Content="+50" Width="70" Height="40" Margin="5" Click="InsertCash_Click" Tag="50" Background="#222" Foreground="#EEE" BorderThickness="0"/>
                                        <Button Content="+100" Width="70" Height="40" Margin="5" Click="InsertCash_Click" Tag="100" Background="#222" Foreground="#EEE" BorderThickness="0"/>
                                        <Button Content="+500" Width="70" Height="40" Margin="5" Click="InsertCash_Click" Tag="500" Background="#222" Foreground="#EEE" BorderThickness="0"/>
                                    </StackPanel>
                                    <Border Background="#111" CornerRadius="8" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Внесено:" Foreground="#666" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="InsertedText" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#EEE" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Сдача:" Foreground="#666" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                            <TextBlock x:Name="PaymentChangeText" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Отмена" Height="45" Margin="0,0,10,0" Background="#222" Foreground="#FFF" BorderThickness="0" Click="CancelPayment_Click"/>
                                    <Button Grid.Column="1" x:Name="ConfirmCashBtn" Content="Готово" Height="45" Margin="10,0,0,0" Background="#4CAF50" Foreground="#FFF" FontWeight="Bold" BorderThickness="0" Click="ConfirmCash_Click" IsEnabled="False"/>
                                </Grid>
                            </Grid>

                            <!-- Слой 4: Заставка -->
                            <Grid x:Name="ScreenSaverView" Visibility="Collapsed" Background="#0A0A0A" Cursor="Hand" MouseLeftButtonUp="ScreenSaver_Click">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="☕" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,15">
                                        <TextBlock.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:1.5" AutoReverse="True"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="1.0" To="1.1" Duration="0:0:1.5" AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </TextBlock.Triggers>
                                        <TextBlock.RenderTransform>
                                            <ScaleTransform CenterX="30" CenterY="30"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock Text="Прикоснитесь к экрану" Foreground="#D4A373" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="чтобы выбрать напиток" Foreground="#666" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Слой 5: Экран входа в админку -->
                            <Grid x:Name="AdminLoginView" Visibility="Collapsed" Background="#0A0A0A" Margin="10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
                                    <TextBlock Text="ВХОД В ПАНЕЛЬ" Foreground="#D4A373" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                    <TextBlock Text="Введите пароль (admin):" Foreground="#666" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                    <PasswordBox x:Name="AdminPasswordBox" Height="35" Background="#222" Foreground="#FFF" BorderBrush="#444" BorderThickness="1" Padding="5" FontSize="16" Margin="0,0,0,15"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Отмена" Height="35" Margin="0,0,5,0" Background="#333" Foreground="#FFF" BorderThickness="0" Click="CancelAdminLogin_Click"/>
                                        <Button Grid.Column="1" Content="Войти" Height="35" Margin="5,0,0,0" Background="#D4A373" Foreground="#111" FontWeight="Bold" BorderThickness="0" Click="LoginAdmin_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Слой 6: АДМИН ПАНЕЛЬ -->
                            <Grid x:Name="AdminPanelView" Visibility="Collapsed" Background="#0A0A0A" Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="ПАНЕЛЬ АДМИНИСТРАТОРА" FontSize="16" FontWeight="Bold" Foreground="#D4A373" HorizontalAlignment="Center" Margin="0,10,0,10"/>

                                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                                    <TabControl.Resources>
                                        <Style TargetType="TabItem">
                                            <Setter Property="Background" Value="#222"/>
                                            <Setter Property="Foreground" Value="#D4A373"/>
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TabItem">
                                                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="5,5,0,0" Margin="0,0,2,0">
                                                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="#333"/>
                                                                <Setter Property="Foreground" Value="#FFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TabControl.Resources>

                                    <TabItem Header="Запасы">
                                        <Border Background="#111" Padding="10" CornerRadius="0,5,5,5">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <!-- КОФЕ -->
                                                    <TextBlock Text="Кофе (г):" Foreground="#EEE" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                                                    <Grid Margin="0,0,0,10">
                                                        <ProgressBar Height="15" Value="{Binding Inventory.CoffeeBeans}" Maximum="{Binding Inventory.MaxCoffee}" Foreground="#D4A373" Background="#222"/>
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="10" FontWeight="Bold">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} / {1}">
                                                                    <Binding Path="Inventory.CoffeeBeans"/>
                                                                    <Binding Path="Inventory.MaxCoffee"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>

                                                    <!-- ВОДА -->
                                                    <TextBlock Text="Вода (мл):" Foreground="#EEE" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                                                    <Grid Margin="0,0,0,10">
                                                        <ProgressBar Height="15" Value="{Binding Inventory.Water}" Maximum="{Binding Inventory.MaxWater}" Foreground="#4CAF50" Background="#222"/>
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="10" FontWeight="Bold">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} / {1}">
                                                                    <Binding Path="Inventory.Water"/>
                                                                    <Binding Path="Inventory.MaxWater"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>

                                                    <!-- МОЛОКО -->
                                                    <TextBlock Text="Молоко (мл):" Foreground="#EEE" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                                                    <Grid Margin="0,0,0,10">
                                                        <ProgressBar Height="15" Value="{Binding Inventory.Milk}" Maximum="{Binding Inventory.MaxMilk}" Foreground="#FFF" Background="#222"/>
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#111" FontSize="10" FontWeight="Bold">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} / {1}">
                                                                    <Binding Path="Inventory.Milk"/>
                                                                    <Binding Path="Inventory.MaxMilk"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>

                                                    <!-- САХАР -->
                                                    <TextBlock Text="Сахар (г):" Foreground="#EEE" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                                                    <Grid Margin="0,0,0,10">
                                                        <ProgressBar Height="15" Value="{Binding Inventory.Sugar}" Maximum="{Binding Inventory.MaxSugar}" Foreground="#E67E22" Background="#222"/>
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="10" FontWeight="Bold">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} / {1}">
                                                                    <Binding Path="Inventory.Sugar"/>
                                                                    <Binding Path="Inventory.MaxSugar"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>

                                                    <!-- СИРОП -->
                                                    <TextBlock Text="Сироп (мл):" Foreground="#EEE" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                                                    <Grid Margin="0,0,0,10">
                                                        <ProgressBar Height="15" Value="{Binding Inventory.Syrup}" Maximum="{Binding Inventory.MaxSyrup}" Foreground="#9B59B6" Background="#222"/>
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="10" FontWeight="Bold">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} / {1}">
                                                                    <Binding Path="Inventory.Syrup"/>
                                                                    <Binding Path="Inventory.MaxSyrup"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>

                                                    <!-- СТАКАНЧИКИ -->
                                                    <TextBlock Text="Стаканчики:" Foreground="#EEE" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                                                    <Grid Margin="0,0,0,10">
                                                        <ProgressBar Height="15" Value="{Binding Inventory.Cups}" Maximum="{Binding Inventory.MaxCups}" Foreground="#3498DB" Background="#222"/>
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="10" FontWeight="Bold">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} / {1}">
                                                                    <Binding Path="Inventory.Cups"/>
                                                                    <Binding Path="Inventory.MaxCups"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>

                                                    <Button Content="Пополнить всё" Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0,10,0,0" Height="30" FontSize="12" Click="RefillInventory_Click"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </TabItem>

                                    <TabItem Header="Меню">
                                        <Border Background="#111" Padding="10" CornerRadius="0,5,5,5">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                    <Button Content="➕ Добавить" Background="#333" Foreground="#FFF" Padding="5,2" FontSize="11" Click="AddMenuItem_Click"/>
                                                    <Button Content="❌ Удалить" Background="#A52A2A" Foreground="#FFF" Padding="5,2" FontSize="11" Margin="5,0,0,0" Click="DeleteMenuItem_Click"/>
                                                </StackPanel>

                                                <DataGrid x:Name="MenuDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                          Background="#0A0A0A" RowBackground="#151515" AlternatingRowBackground="#1A1A1A"
                                                          Foreground="#EEE" BorderBrush="#333" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333"
                                                          HeadersVisibility="Column" RowHeaderWidth="0" FontSize="11">
                                                    <DataGrid.Resources>
                                                        <Style TargetType="DataGridColumnHeader">
                                                            <Setter Property="Background" Value="#222"/>
                                                            <Setter Property="Foreground" Value="#D4A373"/>
                                                            <Setter Property="Padding" Value="2"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </Style>
                                                        <Style TargetType="DataGridCell">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="#EEE"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Background" Value="#333"/>
                                                                    <Setter Property="Foreground" Value="#D4A373"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGrid.Resources>
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Название" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                        <DataGridTextColumn Header="Цена" Binding="{Binding BasePrice, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                                                        <DataGridTextColumn Header="Иконка" Binding="{Binding Icon, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>

                                                <Button Grid.Row="2" Content="💾 Сохранить" Background="#D4A373" Foreground="#111" FontWeight="Bold" Padding="5,2" FontSize="11" Margin="0,5,0,0" Click="SaveJson_Click"/>
                                            </Grid>
                                        </Border>
                                    </TabItem>
                                </TabControl>

                                <Button Grid.Row="2" Content="Закрыть" Background="#222" Foreground="#FFF" Height="30" FontSize="12" Margin="0,10,0,0" Click="CloseAdminPanel_Click"/>
                            </Grid>

                        </Grid>
                    </Border>

                    <!-- ПРАВАЯ КОЛОНКА: СТАКАНЫ + ШАХТА -->
                    <Border Grid.Column="2" Background="#111" BorderBrush="#222" BorderThickness="2,0,0,0" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="200"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,10,0,15">
                                <TextBlock Text="СТАКАНЫ" Foreground="#444" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                <StackPanel x:Name="CupStackPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <Border Height="5" VerticalAlignment="Bottom" Background="#333" CornerRadius="2"/>
                            </Grid>
                            <Border Grid.Row="1" Background="#020202" CornerRadius="5" BorderBrush="#222" BorderThickness="2">
                                <Grid>
                                    <TextBlock Text="ВЫДАЧА" Foreground="#333" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    <StackPanel x:Name="EmptyCupPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="🥤" FontSize="30" Opacity="0.05" Foreground="White"/>
                                    </StackPanel>
                                    <Grid x:Name="CoffeeCup" Width="60" Height="85" VerticalAlignment="Bottom" HorizontalAlignment="Center" Opacity="0" Margin="0,0,0,20" Cursor="Hand" MouseLeftButtonUp="Cup_Click">
                                        <Ellipse Width="50" Height="10" VerticalAlignment="Bottom" Fill="#000" Margin="0,0,0,-5" Opacity="0.8"/>
                                        <Path Data="M 5,5 L 55,5 L 45,70 Q 30,75 15,70 Z">
                                            <Path.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#EAEAEA" Offset="0.0"/>
                                                    <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                                    <GradientStop Color="#D0D0D0" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Path.Fill>
                                        </Path>
                                        <Grid x:Name="CoffeeLiquidContainer">
                                            <Grid.Clip>
                                                <PathGeometry Figures="M 6,6 L 54,6 L 44,69 Q 30,74 16,69 Z" />
                                            </Grid.Clip>
                                            <Rectangle x:Name="CoffeeLiquid" VerticalAlignment="Bottom" Height="0" Fill="#6F4E37" Margin="5,0,5,0"/>
                                        </Grid>
                                        <Path Data="M 5,5 L 55,5 L 45,70 Q 30,75 15,70 Z" Stroke="#888" StrokeThickness="1" Fill="Transparent"/>
                                        <Path Data="M 2,2 L 58,2 L 55,8 L 5,8 Z" Fill="#FFF" Stroke="#CCC" StrokeThickness="1"/>
                                    </Grid>
                                    <TextBlock x:Name="TakeCupText" Text="ЗАБРАТЬ" FontSize="9" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0" Margin="0,0,0,2"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- НИЖНЯЯ ТУМБА -->
                <Border Grid.Row="2" Background="#0A0A0A" CornerRadius="0,0,12,12" BorderBrush="#222" BorderThickness="0,2,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#161616" Margin="10" CornerRadius="5" BorderBrush="#333" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                                <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                                <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                                <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#161616" Margin="10" CornerRadius="5" BorderBrush="#333" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                                <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                                <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                                <Rectangle Width="15" Fill="{StaticResource WoodStripe}" Margin="2"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>